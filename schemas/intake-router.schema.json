{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/intake-router.schema.json",
  "title": "Intake Router Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "confidence",
    "readiness_score",
    "ambiguity_score",
    "activation_signals",
    "suppression_signals",
    "recommended_mode",
    "compact_summary",
    "reason",
    "known_fields",
    "critical_gaps",
    "suggested_questions",
    "provisional_task"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.4"
    },
    "classification": {
      "type": "string",
      "enum": [
        "READY_TO_EXECUTE",
        "NEEDS_LIGHT_REFINEMENT",
        "NEEDS_INTAKE",
        "BLOCKED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "readiness_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "ambiguity_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "activation_signals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suppression_signals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_mode": {
      "type": "string",
      "enum": [
        "execute_now",
        "state_assumptions_then_execute",
        "ask_before_execute",
        "decline_or_redirect"
      ]
    },
    "compact_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "known_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "deliverable",
        "context",
        "audience",
        "constraints",
        "format",
        "success_criteria"
      ],
      "properties": {
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliverable": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_criteria": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "critical_gaps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "suggested_questions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "provisional_task": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 800
    }
  }
}
