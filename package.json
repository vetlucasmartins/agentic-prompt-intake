{
  "name": "agentic-prompt-intake",
  "version": "0.4.0",
  "description": "Intelligent, local-first data ingestion and context optimization engine for AI agents and LLM pipelines.",
  "private": false,
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "bin": {
    "agentic-prompt-intake": "bin/cli.js",
    "intake-refiner": "bin/cli.js"
  },
  "scripts": {
    "validate": "python3 scripts/validate_structure.py",
    "start": "node bin/cli.js",
    "test": "node test/pipeline.test.js",
    "eval": "node scripts/run_eval.mjs",
    "eval:dry": "node scripts/run_eval.mjs --dry-run"
  },
  "dependencies": {
    "local-context-compiler": "file:../lcc"
  },
  "engines": {
    "node": ">=16"
  },
