    "CLAUDE.md",
    "GEMINI.md",
    "CONVENTIONS.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vetlucasmartins/agentic-prompt-intake.git"
